# Copy to deploy/.env (git-ignored) and fill in.

# Goes into a connection URL unescaped, so keep it URL-safe: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
POSTGRES_USER=maailma
POSTGRES_DB=maailma

# Where the server is published on this host. frpc should point at this.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# debug | info | warn | error | silent
LOG_LEVEL=info

# Admin-reviewed hot publication. Keep false unless this deployment should allow it.
# Published versions persist in the content-data volume.
CONTENT_PUBLISHING=false

# Images published by GitHub Actions; deploy/update.sh pulls these. Leave unset
# to build locally with `docker compose up -d --build`.
IMAGE_PREFIX=ghcr.io/nicolascresposu/maailma
# A commit SHA here pins (or rolls back) the deployed version.
IMAGE_TAG=latest
