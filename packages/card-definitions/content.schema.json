                    "type": "integer",
                    "minimum": 1
                  },
                  "weights": {
                    "type": "object",
                    "properties": {
                      "COMMON": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "RARE": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "EPIC": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "LEGENDARY": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
