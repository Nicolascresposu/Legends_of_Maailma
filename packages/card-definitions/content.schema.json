{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maailma.local/content.schema.json",
  "title": "Maailma expansion content, version 1",
  "definitions": {
    "expansion": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "policy": {
          "type": "object",
          "properties": {
            "released": {
              "type": "boolean"
            },
            "tradeable": {
              "type": "boolean"
            },
            "duplicateProtection": {
              "type": "boolean"
            },
            "craftable": {
              "type": "boolean"
            },
            "disenchantable": {
              "type": "boolean"
            },
            "availableInPacks": {
              "type": "boolean"
            },
            "standard": {
              "type": "boolean"
            }
          },
          "required": [
            "released",
            "tradeable",
            "duplicateProtection",
            "craftable",
            "disenchantable",
            "availableInPacks",
            "standard"
          ],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "id", "name", "policy"],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "row": {
          "enum": ["FRONT", "BACK"]
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["row", "column"],
      "additionalProperties": false
    },
    "target": {
      "enum": [
        "PLAY_TARGET",
        "SELF",
        "OWNER_HERO",
        "ENEMY_HERO",
        "RANDOM_ENEMY_CREATURE",
        "ALL_ENEMY_CREATURES",
        "ADJACENT_FRIENDLY_CREATURES",
        "FRIENDLY_WEAPON",
        "ENEMY_WEAPON"
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DEAL_DAMAGE"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            }
          },
          "required": ["type", "amount", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "HEAL"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            }
          },
          "required": ["type", "amount", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DRAW_CARD"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["type", "amount"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "BUFF"
            },
            "attack": {
              "type": "integer"
            },
            "health": {
              "type": "integer"
            },
            "target": {
              "$ref": "#/definitions/target"
            }
          },
          "required": ["type", "attack", "health", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "APPLY_STATUS"
            },
            "status": {
              "enum": ["ROOTED", "HIDDEN", "REVEALED", "WARD", "ATTACK_MODIFIER"]
            },
            "duration": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            }
          },
          "required": ["type", "status", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "SUMMON"
            },
            "definitionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "position": {
              "$ref": "#/definitions/position"
            }
          },
          "required": ["type", "definitionId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "MOVE"
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "destination": {
              "$ref": "#/definitions/position"
            }
          },
          "required": ["type", "target", "destination"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DESTROY"
            },
            "target": {
              "$ref": "#/definitions/target"
            }
          },
          "required": ["type", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "GAIN_TAIKA"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["type", "amount"],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "triggeredEffect": {
      "type": "object",
      "properties": {
        "trigger": {
          "enum": ["ARRIVAL", "LAST_BREATH", "TURN_STARTED", "TURN_ENDED"]
        },
        "effect": {
          "$ref": "#/definitions/effect"
        }
      },
      "required": ["trigger", "effect"],
      "additionalProperties": false
    },
    "card": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": ["CORE", "CHRONICLE"]
            },
            "expansionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "rarity": {
              "enum": ["BASIC", "COMMON", "RARE", "EPIC", "LEGENDARY"]
            },
            "collectible": {
              "type": "boolean"
            },
            "classId": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "pattern": "\\S"
            },
            "flavour": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "const": "CREATURE"
            },
            "attack": {
              "type": "integer",
              "minimum": 0
            },
            "health": {
              "type": "integer",
              "minimum": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "enum": [
                  "ARRIVAL",
                  "LAST_BREATH",
                  "GUARD",
                  "SWIFT",
                  "CHARGE",
                  "RANGED",
                  "WARD",
                  "HIDDEN",
                  "LIFESTEAL"
                ]
              },
              "uniqueItems": true
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/triggeredEffect"
              }
            }
          },
          "required": [
            "id",
            "name",
            "cost",
            "source",
            "expansionId",
            "rarity",
            "collectible",
            "description",
            "type",
            "attack",
            "health",
            "tags",
            "keywords",
            "effects"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": ["CORE", "CHRONICLE"]
            },
            "expansionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "rarity": {
              "enum": ["BASIC", "COMMON", "RARE", "EPIC", "LEGENDARY"]
            },
            "collectible": {
              "type": "boolean"
            },
            "classId": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "pattern": "\\S"
            },
            "flavour": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "const": "ACTION"
            },
            "targetMode": {
              "enum": [
                "NONE",
                "FRIENDLY_CHARACTER",
                "ENEMY_CHARACTER",
                "ANY_CHARACTER",
                "FRIENDLY_CREATURE",
                "ENEMY_CREATURE"
              ]
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/effect"
              }
            }
          },
          "required": [
            "id",
            "name",
            "cost",
            "source",
            "expansionId",
            "rarity",
            "collectible",
            "description",
            "type",
            "targetMode",
            "effects"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": ["CORE", "CHRONICLE"]
            },
            "expansionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "rarity": {
              "enum": ["BASIC", "COMMON", "RARE", "EPIC", "LEGENDARY"]
            },
            "collectible": {
              "type": "boolean"
            },
            "classId": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "pattern": "\\S"
            },
            "flavour": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "const": "ARTIFACT"
            },
            "durability": {
              "type": "integer",
              "minimum": 1
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/triggeredEffect"
              }
            }
          },
          "required": [
            "id",
            "name",
            "cost",
            "source",
            "expansionId",
            "rarity",
            "collectible",
            "description",
            "type",
            "durability",
            "effects"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": ["CORE", "CHRONICLE"]
            },
            "expansionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "rarity": {
              "enum": ["BASIC", "COMMON", "RARE", "EPIC", "LEGENDARY"]
            },
            "collectible": {
              "type": "boolean"
            },
            "classId": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "pattern": "\\S"
            },
            "flavour": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "const": "WEAPON"
            },
            "attack": {
              "type": "integer",
              "minimum": 0
            },
            "durability": {
              "type": "integer",
              "minimum": 1
            },
            "range": {
              "enum": ["MELEE", "RANGED"]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/triggeredEffect"
              }
            }
          },
          "required": [
            "id",
            "name",
            "cost",
            "source",
            "expansionId",
            "rarity",
            "collectible",
            "description",
            "type",
            "attack",
            "durability",
            "range",
            "tags",
            "effects"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/card"
      }
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "expansionId": {
          "type": "string",
          "pattern": "\\S"
        },
        "cardCount": {
          "type": "integer",
          "minimum": 1
        },
        "rarityRules": {
          "type": "object",
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "weights": {
                    "type": "object",
                    "properties": {
                      "COMMON": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "RARE": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "EPIC": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "LEGENDARY": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
                  }
                },
                "required": ["count", "weights"],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": ["slots"],
          "additionalProperties": false
        }
      },
      "required": ["id", "name", "expansionId", "cardCount", "rarityRules"],
      "additionalProperties": false
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/pack"
      }
    }
  }
}
