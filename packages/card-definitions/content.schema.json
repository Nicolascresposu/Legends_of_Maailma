          "required": ["type", "amount"],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "card": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "cost": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": ["CORE", "CHRONICLE"]
            },
            "expansionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "rarity": {
              "enum": ["BASIC", "COMMON", "RARE", "EPIC", "LEGENDARY"]
            },
            "collectible": {
              "type": "boolean"
            },
            "classId": {
              "type": "string",
              "pattern": "\\S"
            },
            "description": {
              "type": "string"
            },
            "flavour": {
              "type": "string",
              "pattern": "\\S"
            },
            "artist": {
              "type": "string",
              "pattern": "\\S"
            },
            "type": {
              "const": "CREATURE"
            },
            "attack": {
              "type": "integer",
              "minimum": 0
            },
            "health": {
              "type": "integer",
              "minimum": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "enum": [
                  "ARRIVAL",
                  "LAST_BREATH",
                  "GUARD",
                  "SWIFT",
                  "CHARGE",
                  "RANGED",
                  "WARD",
                  "HIDDEN",
                  "LIFESTEAL"
                ]
              },
              "uniqueItems": true
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/triggeredEffect"
              }
            },
            "auras": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/aura"
              }
            }
          },
          "required": [
            "id",
            "name",
            "cost",
            "source",
            "expansionId",
            "rarity",
            "collectible",
            "description",
            "type",
            "attack",
            "health",
            "tags",
            "keywords",
            "effects"
          ],
          "additionalProperties": false
