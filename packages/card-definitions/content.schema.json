{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maailma.local/content.schema.json",
  "title": "Maailma expansion content, version 1",
  "definitions": {
    "expansion": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "policy": {
          "type": "object",
          "properties": {
            "released": {
              "type": "boolean"
            },
            "tradeable": {
              "type": "boolean"
            },
            "duplicateProtection": {
              "type": "boolean"
            },
            "craftable": {
              "type": "boolean"
            },
            "disenchantable": {
              "type": "boolean"
            },
            "availableInPacks": {
              "type": "boolean"
            },
            "standard": {
              "type": "boolean"
            }
          },
          "required": [
            "released",
            "tradeable",
            "duplicateProtection",
            "craftable",
            "disenchantable",
            "availableInPacks",
            "standard"
          ],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "id", "name", "policy"],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "row": {
          "enum": ["FRONT", "BACK"]
        },
        "column": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["row", "column"],
      "additionalProperties": false
    },
    "tag": {
      "type": "string",
      "pattern": "S"
    },
    "cardType": {
      "enum": ["CREATURE", "ACTION", "ARTIFACT", "WEAPON", "LOCATION"]
    },
    "target": {
      "enum": [
        "PLAY_TARGET",
        "SELF",
        "OWNER_HERO",
        "ENEMY_HERO",
        "RANDOM_ENEMY_CREATURE",
        "ALL_ENEMY_CREATURES",
        "ADJACENT_FRIENDLY_CREATURES",
        "ALL_FRIENDLY_CREATURES",
        "OTHER_FRIENDLY_CREATURES",
        "RANDOM_OTHER_FRIENDLY_CREATURE",
        "TRIGGERING_CREATURE",
        "FRIENDLY_WEAPON",
        "ENEMY_WEAPON"
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CONTROLS_CREATURE"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "atLeast": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "HOLDS_CARD"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "cardType": {
              "$ref": "#/definitions/cardType"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DEAL_DAMAGE"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "amount", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "HEAL"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "amount", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DRAW_CARD"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "amount"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "BUFF"
            },
            "attack": {
              "type": "integer"
            },
            "health": {
              "type": "integer"
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "attack", "health", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "APPLY_STATUS"
            },
            "status": {
              "enum": ["ROOTED", "HIDDEN", "REVEALED", "WARD", "ATTACK_MODIFIER"]
            },
            "duration": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "status", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "SUMMON"
            },
            "definitionId": {
              "type": "string",
              "pattern": "\\S"
            },
            "position": {
              "$ref": "#/definitions/position"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "definitionId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "SUMMON_RANDOM"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "position": {
              "$ref": "#/definitions/position"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "MOVE"
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "destination": {
              "$ref": "#/definitions/position"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "target", "destination"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "DESTROY"
            },
            "target": {
              "$ref": "#/definitions/target"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "GAIN_TAIKA"
            },
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "condition": {
              "$ref": "#/definitions/condition"
            }
          },
          "required": ["type", "amount"],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "triggeredEffect": {
      "type": "object",
      "properties": {
        "trigger": {
          "enum": [
            "ARRIVAL",
            "LAST_BREATH",
            "TURN_STARTED",
            "TURN_ENDED",
            "FRIENDLY_CREATURE_SUMMONED",
            "FRIENDLY_CREATURE_DIED"
          ]
        },
        "tag": {
          "$ref": "#/definitions/tag"
        },
        "effect": {
          "$ref": "#/definitions/effect"
        }
      },
      "required": ["trigger", "effect"],
      "additionalProperties": false
    },
    "aura": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "STAT_AURA"
            },
            "attack": {
              "type": "integer",
              "minimum": 0
            },
            "health": {
              "type": "integer",
              "minimum": 0
            },
            "target": {
              "enum": ["OTHER_FRIENDLY_CREATURES", "ADJACENT_FRIENDLY_CREATURES"]
            },
            "tag": {
              "$ref": "#/definitions/tag"
            }
          },
          "required": ["type", "attack", "health", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "COST_AURA"
            },
            "amount": {
              "type": "integer"
            },
            "tag": {
              "$ref": "#/definitions/tag"
            },
            "cardType": {
