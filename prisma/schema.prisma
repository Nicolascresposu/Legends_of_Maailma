// Long-term persistence for accounts, decks and social play.
//
// Active matches deliberately stay out of this schema: they live behind
// `MatchRepository` in server memory, so a match in progress never depends on
// a database round trip. What lands here is the durable material around a
// match — who a player is, what they may play, and who they may challenge.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered player.
///
/// `displayName` is what other players see and is what friend requests are
/// addressed to; `email` is only ever used to sign in.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String   @unique
  passwordHash String
  /// Whether this account may change expansion policies and reach the
  /// unreleased content those policies hide. Off by default: an ordinary
  /// player must not be able to release a set by guessing a route.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  decks               Deck[]
  collection          CollectionEntry[]
  economy             UserEconomy?
  transactions        EconomyTransaction[]
  economyRequests     EconomyRequest[]
  tradesAsA           Trade[]              @relation("TradeParticipantA")
  tradesAsB           Trade[]              @relation("TradeParticipantB")
  sentFriendships     Friendship[]         @relation("FriendshipRequester")
  receivedFriendships Friendship[]         @relation("FriendshipAddressee")
  sentChallenges      Challenge[]          @relation("ChallengeChallenger")
  receivedChallenges  Challenge[]          @relation("ChallengeOpponent")

  @@map("users")
}

/// An opaque bearer token. Tokens are stored hashed so a database leak does
/// not hand over live sessions, and deleting a row revokes access instantly.
model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A saved deck list. Card ids reference the immutable card registry in
/// `@maailma/card-definitions` rather than a table, because definitions are
/// code-owned data in this milestone.
enum DeckFormat {
  STANDARD
  WILD
}

model Deck {
  id        String     @id @default(uuid())
  userId    String
  name      String
  heroId    String
  cardIds   String[]
  /// The format the deck is built for. Standard is the default because it is
  /// the format a new deck is normally meant for; a deck holding rotated cards
  /// is stored all the same and simply reports itself unplayable in Standard.
  format    DeckFormat @default(STANDARD)
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("decks")
}

/// How many copies of a card a player owns.
///
/// Stored as a count rather than a flag because deck legality is already
/// expressed in copies: two of a common, one of a legendary. A card absent
/// from this table is simply unowned.
model CollectionEntry {
  id        String   @id @default(uuid())
  userId    String
  cardId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@map("collection_entries")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

/// A directed friend request that becomes a symmetric friendship once
/// accepted. The pair is stored once, ordered by who asked.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// An invitation to play. Accepting one creates a match and stores its id, so
/// both clients can be pointed at the same match.
model Challenge {
  id           String          @id @default(uuid())
  challengerId String
  opponentId   String
  scenarioId   String
  deckId       String?
  status       ChallengeStatus @default(PENDING)
  matchId      String?
  createdAt    DateTime        @default(now())
  respondedAt  DateTime?
  expiresAt    DateTime

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@map("challenges")
}

/// A live override of an expansion's shipped policy.
///
/// Expansion definitions themselves stay code-owned alongside the cards, but
/// their policies have to be changeable without a redeploy: rotating a set out
/// of Standard or switching duplicate protection on is an operational act, not
/// a release. A row here shadows the defaults in `@maailma/card-definitions`;
/// absent, the shipped values apply. Every flag is stored outright rather than
/// as a partial patch, so what is in effect is readable in one glance.
model ExpansionPolicyOverride {
  expansionId         String   @id
  released            Boolean
  tradeable           Boolean
  duplicateProtection Boolean
  craftable           Boolean
  disenchantable      Boolean
  availableInPacks    Boolean
  standard            Boolean
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@map("expansion_policy_overrides")
}

/// A player's Fragment balance.
///
/// Separate from `User` so that crafting can lock this row alone: two
/// simultaneous crafts contend on the balance, not on the account. `version`
/// gives optimistic concurrency a handle for callers that prefer it to a
/// conditional update.
model UserEconomy {
  userId          String   @id
  fragmentBalance Int      @default(0)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_economy")
}

enum EconomyTransactionType {
  CRAFT
  DISENCHANT
  TRADE
  PACK_OPEN
  REWARD
  ADMIN_GRANT
}

/// An immutable record of everything that moved a card or a Fragment.
///
/// Deliberately an audit log and nothing more: collection state is the
/// quantity table, never a fold over this one. Pack generation in particular
/// must not read it — duplicate protection answers to what a player owns right
/// now, not to what they have ever owned.
model EconomyTransaction {
  id            String                 @id @default(uuid())
  userId        String
  type          EconomyTransactionType
  cardId        String?
  quantity      Int                    @default(0)
  fragmentDelta Int                    @default(0)
  /// Free-form context: the trade or pack behind this row, the policy that
  /// applied, the rarity that priced it.
  metadata      Json?
  tradeId       String?
  requestId     String?
  createdAt     DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tradeId])
  @@map("economy_transactions")
}

/// A completed economy request, keyed by the client's own request id.
///
/// A retried craft must not spend the Fragments twice. The first attempt
/// writes this row inside the same transaction as its effects, so a duplicate
/// request collides on the primary key and is answered with the original
/// outcome instead of being executed again.
model EconomyRequest {
  requestId String   @id
  userId    String
  operation String
  /// The response the first attempt produced, replayed verbatim on a retry.
  result    Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("economy_requests")
}

enum TradeStatus {
  OPEN
  ACCEPTED
  CANCELLED
  FAILED
}

/// A direct card-for-card trade between two players.
///
/// Offered cards are never reserved: a player may disenchant or re-offer a
/// card that sits in an open trade, and it is the trade that fails at
/// execution rather than the other actions that are blocked. `revision` is
/// what both acceptances have to agree on, so an offer edited after one player
/// accepted cannot execute on the strength of that stale acceptance.
model Trade {
  id             String      @id @default(uuid())
  participantAId String
  participantBId String
  status         TradeStatus @default(OPEN)
  revision       Int         @default(0)
  acceptedARev   Int?
  acceptedBRev   Int?
  /// Why a finalisation failed, kept so the UI can say more than "it failed".
  failureCode    String?
  failureMessage String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?

  participantA User        @relation("TradeParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User        @relation("TradeParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  items        TradeItem[]

  @@index([participantAId, status])
  @@index([participantBId, status])
  @@map("trades")
}

/// One card stack on one side of a trade. A card appears at most once per
/// side: quantities are normalised rather than accumulated across rows.
model TradeItem {
  id             String @id @default(uuid())
  tradeId        String
  offeringUserId String
  cardId         String
  quantity       Int

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, offeringUserId, cardId])
  @@index([tradeId])
  @@map("trade_items")
}

/// What a completed trade moved, frozen at the moment it committed.
///
/// Kept apart from `TradeItem` because that table goes on describing a live,
/// editable offer, while this one must still read true years later — after the
/// expansions involved have stopped being tradeable, and after the cards
/// themselves have moved on again.
model TradeHistoryEntry {
  id          String   @id @default(uuid())
  tradeId     String
  revision    Int
  fromUserId  String
  toUserId    String
  cardId      String
  quantity    Int
  /// The expansion and policy context that permitted the trade, recorded so a
  /// later policy change never makes history look illegal.
  context     Json?
  completedAt DateTime @default(now())

  @@index([tradeId])
  @@index([fromUserId, completedAt])
  @@index([toUserId, completedAt])
  @@map("trade_history")
}
