// Long-term persistence for accounts, decks and social play.
//
// Active matches deliberately stay out of this schema: they live behind
// `MatchRepository` in server memory, so a match in progress never depends on
// a database round trip. What lands here is the durable material around a
// match — who a player is, what they may play, and who they may challenge.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A registered player.
///
/// `displayName` is what other players see and is what friend requests are
/// addressed to; `email` is only ever used to sign in.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  decks               Deck[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  sentChallenges      Challenge[]  @relation("ChallengeChallenger")
  receivedChallenges  Challenge[]  @relation("ChallengeOpponent")

  @@map("users")
}

/// An opaque bearer token. Tokens are stored hashed so a database leak does
/// not hand over live sessions, and deleting a row revokes access instantly.
model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A saved deck list. Card ids reference the immutable card registry in
/// `@maailma/card-definitions` rather than a table, because definitions are
/// code-owned data in this milestone.
model Deck {
  id        String   @id @default(uuid())
  userId    String
  name      String
  heroId    String
  cardIds   String[]
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("decks")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

/// A directed friend request that becomes a symmetric friendship once
/// accepted. The pair is stored once, ordered by who asked.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// An invitation to play. Accepting one creates a match and stores its id, so
/// both clients can be pointed at the same match.
model Challenge {
  id           String          @id @default(uuid())
  challengerId String
  opponentId   String
  scenarioId   String
  deckId       String?
  status       ChallengeStatus @default(PENDING)
  matchId      String?
  createdAt    DateTime        @default(now())
  respondedAt  DateTime?
  expiresAt    DateTime

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([opponentId, status])
  @@index([challengerId, status])
  @@map("challenges")
}
